{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardianspec.org/schemas/operation.schema.json",
  "title": "Operation",
  "description": "Formal spec §7. One entry in a did:guardian operation log (REQ-7-2's nine types).",
  "oneOf": [
    { "$ref": "operations/create.schema.json" },
    { "$ref": "operations/update.schema.json" },
    { "$ref": "operations/addGuardian.schema.json" },
    { "$ref": "operations/updateGuardian.schema.json" },
    { "$ref": "operations/removeGuardian.schema.json" },
    { "$ref": "operations/setPolicy.schema.json" },
    { "$ref": "operations/acceptWard.schema.json" },
    { "$ref": "operations/releaseWard.schema.json" },
    { "$ref": "operations/deactivate.schema.json" }
  ]
}
