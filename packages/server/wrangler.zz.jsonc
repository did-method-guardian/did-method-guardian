// zz's own deployment of this registrar -- a concrete example of a real
// operator's config, kept alongside the generic wrangler.jsonc rather than
// replacing it. Same code, different name/database/domain; nothing in this
// package depends on zz specifically. Deploy with:
//   wrangler deploy -c wrangler.zz.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zz-guardian-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "d1_databases": [
    { "binding": "DB", "database_name": "zz-guardian", "database_id": "651d3286-cf1f-4e57-a9fb-7d237e8d8174", "migrations_dir": "migrations" }
  ],
  // Cloudflare's own native Email Sending binding (emailProviders.ts's
  // "cloudflare-native" option) -- no external account or API key, just
  // this binding plus `wrangler email sending enable zzmq.dev` (already
  // done; `wrangler email sending list` confirms it). The one deliberately
  // Workers-specific email provider in an otherwise-portable list.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // The bare zone, not a dedicated subdomain -- did:guardian:zzmq.dev is
    // zz's own real identity, the whole point of the bare-domain identity
    // feature. zzmq.dev already has zz-maintainer's own catch-all route
    // (zzmq.dev/*) on the same zone; these routes list the registrar's own
    // specific paths as plain (non-custom_domain) route patterns instead,
    // which Cloudflare matches by specificity -- these take precedence over
    // zz-maintainer's catch-all for exactly these paths, nothing else.
    "REGISTRAR_DOMAIN": "zzmq.dev",
    "EMAIL_PROVIDER": "cloudflare-native"
  },
  // Trailing "*" on every one of these, even ones with no further real
  // path to match -- confirmed live, empirically: a non-wildcard exact-
  // path route on this zone stopped matching the instant a query string
  // was present (e.g. "zzmq.dev/authorize?client_id=..." fell through to
  // zz-maintainer's own catch-all, while the bare "zzmq.dev/authorize"
  // with no query matched this Worker correctly) -- a real Cloudflare
  // routing quirk, not a theoretical one. The "*" costs nothing here
  // (none of these paths collide with anything zz-maintainer serves) and
  // makes every one of them query-string-safe.
  "routes": [
    { "pattern": "zzmq.dev/.well-known/guardian/*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/.well-known/openid-configuration*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/.well-known/jwks.json*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/register*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/verify-email*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/authorize*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/token*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/userinfo*", "zone_name": "zzmq.dev" },
    // pending_operations (v0.2, task #108): .../pending/<id>/... is under
    // /.well-known/guardian/* already, but "list pending for me" is
    // signer-scoped, not ward-scoped, so it's its own top-level path.
    { "pattern": "zzmq.dev/api/me/pending-signatures*", "zone_name": "zzmq.dev" },
    // Named "/guardian-login", not "/login" -- zz-maintainer's own catch-all
    // already serves a "/login" of its own (its human-facing sign-in page);
    // confirmed by reading its route table directly, not assumed.
    { "pattern": "zzmq.dev/guardian-login*", "zone_name": "zzmq.dev" },
    // Dynamic OAuth client registration (RFC 7591) and token revocation
    // (RFC 7009) -- confirmed no collision with zz-maintainer's own routes
    // (it has no bare "/oauth/*" or "/revoke", only nested ones like
    // "/profile/tokens/.../revoke").
    { "pattern": "zzmq.dev/oauth/*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/revoke*", "zone_name": "zzmq.dev" },
    // The account dashboard -- confirmed no collision with zz-maintainer's
    // own routes (it has no "/account" path at all) before this was added,
    // not after.
    { "pattern": "zzmq.dev/account*", "zone_name": "zzmq.dev" },
    // A2A interop (registrar API spec §11) -- confirmed no collision with
    // zz-maintainer's own routes before this was added, not after.
    { "pattern": "zzmq.dev/.well-known/agent-card.json*", "zone_name": "zzmq.dev" },
    { "pattern": "zzmq.dev/.well-known/webfinger*", "zone_name": "zzmq.dev" },
    // MCP interop (registrar API spec §12) -- confirmed no collision with
    // zz-maintainer's own routes before this was added, not after.
    { "pattern": "zzmq.dev/.well-known/oauth-protected-resource*", "zone_name": "zzmq.dev" }
  ],
  // Daily reminder sweep for still-collecting proposals (task #113).
  "triggers": {
    "crons": ["0 12 * * *"]
  }
}
