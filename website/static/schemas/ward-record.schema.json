{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardianspec.org/schemas/ward-record.schema.json",
  "title": "WardRecord",
  "description": "Formal spec REQ-6-4. A record in `wards`.",
  "type": "object",
  "properties": {
    "did": { "type": "string", "pattern": "^did:guardian:[a-z0-9-]+(\\.[a-z0-9-]+)+(:[a-z0-9-]{3,32})?$", "description": "The ward's own did:guardian DID." },
    "anchor": { "type": "string", "description": "The anchor of that DID's log." }
  },
  "required": ["did", "anchor"],
  "additionalProperties": false
}
