{
  "name": "@did-guardian/cli",
  "version": "0.2.0",
  "description": "Command-line tool for did:guardian: generate keys, register and resolve identities, and manage guardianship (add, recover, deactivate).",
  "type": "module",
  "bin": {
    "did-guardian": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/src/index.js",
    "test": "npm run build && node --test dist/tests"
  },
  "dependencies": {
    "@did-guardian/lib": "^0.2.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/did-method-guardian/did-method-guardian.git",
    "directory": "packages/cli"
  },
  "homepage": "https://guardianspec.org/docs/how-to/",
  "bugs": "https://github.com/did-method-guardian/did-method-guardian/issues",
  "keywords": ["did", "decentralized-identity", "ssi", "guardianship", "cli"],
  "engines": {
    "node": ">=18"
  }
}
