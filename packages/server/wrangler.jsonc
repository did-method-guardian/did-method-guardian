{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardian-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // This name/database_id pair is a placeholder -- each operator (including
  // zz's own deployment) creates their own D1 database and fills in a real
  // database_id here; see README.md for the full self-hosting setup.
  "d1_databases": [
    { "binding": "DB", "database_name": "guardian-server", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }
  ],
  // Per-IP rate limiting on /register and /guardian-login (rateLimit.ts) --
  // optional: checkRateLimit fails open (no limiting) if this isn't bound,
  // but a real public deployment should configure it. Create with
  // `wrangler kv namespace create <some-title>`, then fill in the id below.
  // "kv_namespaces": [
  //   { "binding": "RATE_LIMIT_KV", "id": "REPLACE_ME" }
  // ],
  // Outbound email (optional -- see README.md §5). Uncomment both lines
  // below for Cloudflare's own native Email Sending binding (no external
  // account needed, just `wrangler email sending enable <your-domain>`
  // first) -- or leave both commented and set EMAIL_PROVIDER to
  // "mailchannels"/"resend" plus that provider's own API key secret
  // instead, for a self-hoster not on Cloudflare (or who'd rather not
  // depend on this one Workers-specific option).
  // "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "REGISTRAR_DOMAIN": "guardianspec.org"
    // "EMAIL_PROVIDER": "cloudflare-native"
    // Uncomment for a single-operator deployment (a personal domain, or a
    // business creating accounts for its own team and agents) that
    // shouldn't let the general public register -- see README.md's own
    // self-hosting section. Open (the default, same as leaving this unset)
    // is this project's own public registrars; closed blocks anonymous
    // self-service at /register, while the admin console (/admin, gated to
    // the root identity -- see ROOT_WARD_LOGIN_SECRET below) still creates
    // accounts for other people or agents.
    // "REGISTRATION_MODE": "closed"
  },
  // Daily reminder sweep for still-collecting proposals (task #113) --
  // noon UTC, an arbitrary but fixed daily time, nothing protocol-level
  // depends on the exact hour.
  "triggers": {
    "crons": ["0 12 * * *"]
  }
}
