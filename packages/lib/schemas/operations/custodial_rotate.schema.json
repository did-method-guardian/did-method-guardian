{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardianspec.org/schemas/operations/custodial_rotate.schema.json",
  "title": "custodial_rotate",
  "description": "Formal spec §7.2. Replaces operationalKeys/verificationMethods/services wholesale.",
  "type": "object",
  "properties": {
    "type": { "const": "custodial_rotate" },
    "operationalKeys": { "type": "array", "items": { "type": "string" } },
    "verificationMethods": { "type": "object", "additionalProperties": { "type": "string" } },
    "services": { "type": "object" },
    "prev": { "type": "string" },
    "sig": { "type": "string", "description": "REQ-7.2-1(a): signed by any single current operational key." },
    "sigs": { "type": "object", "additionalProperties": { "type": "string" }, "description": "REQ-7.2-1(b): guardian-initiated recovery rotation, keyed by guardian DID. Mutually exclusive with sig in practice." }
  },
  "required": ["type", "operationalKeys", "verificationMethods", "services", "prev"],
  "additionalProperties": false
}
